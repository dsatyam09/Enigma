# Track only the frontend/backend folders and the API spec for now
/*
!/.gitignore
!/frontend/
!/backend/
!/leaderboard-api.yaml

# Inside frontend/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.*
!frontend/.env.example

# Inside backend/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.env
backend/.env.*
!backend/.env.example
# OS
.DS_Store
