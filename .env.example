# ── PostgreSQL (docker-compose managed) ───────────────────────────────────────
DB_PASSWORD=change_me_strong_password

# Injected automatically by docker-compose — override only when pointing to an
# external database (e.g. Supabase).
DATABASE_URL=postgresql+asyncpg://app:change_me_strong_password@db:5432/leaderboard

# Optional read replica. Falls back to DATABASE_URL when unset.
DATABASE_READ_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
# On EC2 replace with your domain or http://<EC2_PUBLIC_IP>
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Cache falls back to no-op when Redis is unreachable — safe to leave unset.
REDIS_URL=
CACHE_TTL_SECONDS=30
