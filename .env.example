# Postgres password (used by docker-compose to initialize the db service)
DB_PASSWORD=change_me_strong_password

# Full asyncpg connection string. Injected automatically by docker-compose
# when using the bundled db service; override only when pointing at an
# external database.
DATABASE_URL=postgresql+asyncpg://app:change_me_strong_password@db:5432/leaderboard

# Optional read-replica URL. Falls back to DATABASE_URL when empty.
DATABASE_READ_URL=

# Comma-separated list of allowed CORS origins for the frontend.
# On EC2 replace with your domain or http://<EC2_PUBLIC_IP>
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Redis URL for the response cache. The cache degrades to a
# no-op when Redis is unreachable, so it is safe to leave unset.
REDIS_URL=
CACHE_TTL_SECONDS=30
